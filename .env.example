# Copy to .env and adjust. Every value is optional.

# Security — always set a long random SECRET_KEY in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALLOW_REGISTRATION=true

# Database (defaults to SQLite in instance/shopmotion.db)
# DATABASE_URL=sqlite:///instance/shopmotion.db
AUTO_CREATE_TABLES=true

# AI pipeline
YOLO_MODEL=yolov8n.pt
DETECTOR_BACKEND=auto        # auto | yolo | hog
TRACKER_BACKEND=auto         # auto | deepsort | centroid
INFERENCE_EVERY_N_FRAMES=2

# Email alerts (enable them on the Settings page)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_SENDER=you@example.com
# SMTP_TLS=true

# Streaming / logging
STREAM_JPEG_QUALITY=75
LOG_LEVEL=INFO

# Dev server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
